{
  "identity": {
    "name": "Keepsake Studio",
    "tagline": "Capturing Candid, Real, Emotional Moments",
    "vibe": "Instagram Storytelling + Cinematic Memory Capture + Luxury Lifestyle",
    "archetype": "Organic & Earthy (Luxury Variant)",
    "target_audience": "Couples, Event Planners, Lifestyle Brands"
  },
  "typography": {
    "primary_font": "Playfair Display",
    "secondary_font": "Manrope",
    "accent_font": "Dancing Script",
    "usage": {
      "headings": "Playfair Display, font-serif, tracking-tight, leading-none",
      "body": "Manrope, font-sans, leading-relaxed, tracking-wide",
      "accents": "Dancing Script, font-cursive, text-accent"
    },
    "scale": {
      "h1": "text-6xl md:text-8xl font-medium",
      "h2": "text-4xl md:text-6xl font-normal",
      "h3": "text-2xl md:text-3xl font-medium",
      "body": "text-base md:text-lg text-muted-foreground"
    }
  },
  "colors": {
    "palette": {
      "background": "#F9F8F6",
      "foreground": "#4A4036",
      "primary": "#D4AF37",
      "secondary": "#E8DCCA",
      "accent": "#E6C2BF",
      "muted": "#F2EBE5",
      "border": "#E6DCD3"
