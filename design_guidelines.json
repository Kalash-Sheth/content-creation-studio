      "assets": [
        "https://images.unsplash.com/photo-1712491058340-ec237ec2cb64?crop=entropy&cs=srgb&fm=jpg&q=85",
        "https://images.unsplash.com/photo-1705091688077-ac75287a1e6f?crop=entropy&cs=srgb&fm=jpg&q=85"
      ]
