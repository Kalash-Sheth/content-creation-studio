  "visual_enhancers": {
    "textures": {
      "grain": "url('https://images.unsplash.com/photo-1708379584923-f44da1553304?crop=entropy&cs=srgb&fm=jpg&q=85')",
      "paper": "url('https://images.unsplash.com/photo-1658573386529-50450f20c563?crop=entropy&cs=srgb&fm=jpg&q=85')"
