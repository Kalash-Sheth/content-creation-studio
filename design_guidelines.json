    "usage": {
      "bg_main": "bg-[#F9F8F6]",
      "text_main": "text-[#4A4036]",
      "text_muted": "text-[#8C8070]",
      "accent_gold": "text-[#D4AF37]",
      "accent_rose": "bg-[#E6C2BF]",
      "glass_bg": "bg-[#F9F8F6]/80 backdrop-blur-xl border-white/20"
    },
    "gradients": {
      "hero_overlay": "bg-gradient-to-b from-black/30 via-transparent to-[#F9F8F6]",
      "gold_shimmer": "bg-gradient-to-r from-[#D4AF37] via-[#F2EBE5] to-[#D4AF37]"
    }
