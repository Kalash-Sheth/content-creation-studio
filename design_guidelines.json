  "motion_guidelines": {
    "library": "framer-motion",
    "scroll": "lenis (smooth scrolling)",
    "transitions": {
      "default": "ease: [0.22, 1, 0.36, 1], duration: 0.8",
      "hover": "scale: 1.02, duration: 0.3"
    },
    "effects": [
      "Parallax on images",
      "Staggered text reveal (word by word)",
      "Slow fade-in for sections"
    ]
  },
  "image_urls": {
    "hero_bg": "https://images.unsplash.com/photo-1738851952441-2a7d17487545?crop=entropy&cs=srgb&fm=jpg&q=85",
    "texture_grain": "https://images.unsplash.com/photo-1708379584923-f44da1553304?crop=entropy&cs=srgb&fm=jpg&q=85",
    "texture_paper": "https://images.unsplash.com/photo-1658573386529-50450f20c563?crop=entropy&cs=srgb&fm=jpg&q=85",
    "camera_vintage": "https://images.unsplash.com/photo-1763922739054-2b0cdf39c8c5?crop=entropy&cs=srgb&fm=jpg&q=85",
    "wedding_couple": "https://images.unsplash.com/photo-1720617550153-7242f81ccbd6?crop=entropy&cs=srgb&fm=jpg&q=85",
    "party_laugh": "https://images.unsplash.com/photo-1766113482209-0723f874e425?crop=entropy&cs=srgb&fm=jpg&q=85",
    "videographer": "https://images.unsplash.com/photo-1630978781617-816e79eaffeb?crop=entropy&cs=srgb&fm=jpg&q=85"
  },
  "instructions_to_main_agent": [
    "INSTALL 'lenis' for smooth scrolling immediately. Standard scrolling kills the luxury vibe.",
    "Use 'Playfair Display' for all Headings (H1-H3). Use 'Manrope' for body text.",
    "Implement the 'Grain' texture as a fixed overlay with low opacity (opacity-5) and pointer-events-none.",
    "Do NOT use standard Shadcn cards. Create custom 'div' based cards with the specified border radius and shadow.",
    "Ensure the 'Hero' section video/image covers the full viewport (h-screen).",
    "Use the 'Rose Gold' (#E6C2BF) sparingly for hover states or small accents, not as a main background.",
    "The 'Instagram Grid' must be responsive: 1 column on mobile, 3 columns on desktop.",
    "Add 'data-testid' to all interactive elements."
  ],
  "UNIVERSAL_GUIDELINES_FOR_MAIN_AGENT": [
    "Avoid generic 'AI slop' designs. No centered text blocks without purpose.",
    "Use 2-3x more padding than usual. Luxury = Space.",
    "Micro-animations are mandatory. Nothing should appear without a transition.",
    "Use the provided image URLs. Do not use placeholders.",
    "Respect the 'Light Theme' constraint. Dark backgrounds only for specific 'Cinematic' sections."
  ]
}